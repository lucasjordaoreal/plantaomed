{
  "name": "plantaomed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run catalog:validate && npm run catalog:generate",
    "dev": "vite",
    "prebuild": "npm run catalog:validate && npm run catalog:generate",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run && npm run catalog:validate",
    "catalog:validate": "node scripts/medical-import/validate.mjs",
    "catalog:generate": "node scripts/medical-import/generate.mjs",
    "catalog:import:anvisa": "node scripts/medical-import/import-anvisa-medicines.mjs",
    "catalog:import:conitec": "node scripts/medical-import/import-conitec-pcdt.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
